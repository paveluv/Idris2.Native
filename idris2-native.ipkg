package idris2-native

version = 0.1.0
authors = "Pavel Uvarov"
license = "BSD-3-Clause"
brief = "Idris 2 with a native code generator"

depends = idris2, contrib, network

sourcedir = "src"

-- Installed as a library too, for the tests that build terms and programs
-- with the code generator's own modules.
modules =
    Compiler.Native.Bytes,
    Data.Builder,
    Data.Distinct,
    Data.WriteBuilder,
    Compiler.Native.ELF,
    Compiler.Native.HeapObject.BignumEnc,
    Compiler.Native.HeapObject.Enc,
    Compiler.Native.HeapObject.Header,
    Compiler.Native.HeapObject.Kind,
    Compiler.Native.HeapObject.LayoutWord,
    Compiler.Native.HeapObject.StringEnc,
    Compiler.Native.HeapObject.ValEnc,
    Compiler.Native.IRCommon.Area,
    Compiler.Native.IRCommon.ConIds,
    Compiler.Native.IRCommon.Conv,
    Compiler.Native.IRCommon.Intrinsic,
    Compiler.Native.IRCommon.Op,
    Compiler.Native.IRCommon.Ty,
    Compiler.Native.Link,
    Compiler.Native.Linkage.Areas,
    Compiler.Native.Linkage.ConvertsIn,
    Compiler.Native.Linkage.ForeignFunctions,
    Compiler.Native.Linkage.InlineExtern,
    Compiler.Native.Linkage.OSService,
    Compiler.Native.Linkage.ResumePoint,
    Compiler.Native.Linkage.Routine,
    Compiler.Native.Linkage.Sym,
    Compiler.Native.LocatedIR.Block,
    Compiler.Native.LocatedIR.Cont,
    Compiler.Native.LocatedIR.Function,
    Compiler.Native.LocatedIR.Instr,
    Compiler.Native.LocatedIR.Label,
    Compiler.Native.LocatedIR.Mem,
    Compiler.Native.LocatedIR.Opnd,
    Compiler.Native.LocatedIR.Program,
    Compiler.Native.LocatedIR.Reg,
    Compiler.Native.LocatedIR.Static,
    Compiler.Native.LocatedIR.Terminator,
    Compiler.Native.LocatedIR.Dump,
    Compiler.Native.Lower,
    Compiler.Native.LowerFlat,
    Compiler.Native.Platform,
    Compiler.Native.Native,
    Compiler.Native.RegAlloc,
    Compiler.Native.Seed,
    Compiler.Native.Strings,
    Compiler.Native.Target,
    Compiler.Native.TermIR.Body,
    Compiler.Native.TermIR.Decls,
    Compiler.Native.TermIR.Def,
    Compiler.Native.TermIR.FieldTys,
    Compiler.Native.TermIR.Instr,
    Compiler.Native.TermIR.IsInt,
    Compiler.Native.TermIR.Mem,
    Compiler.Native.TermIR.Opnd,
    Compiler.Native.TermIR.OvOp,
    Compiler.Native.TermIR.Program,
    Compiler.Native.TermIR.Sig,
    Compiler.Native.TermIR.Sizes,
    Compiler.Native.TermIR.StaticDef,
    Compiler.Native.TermIR.StaticSig,
    Compiler.Native.TermIR.Var,
    Compiler.Native.TermIR.Build,
    Compiler.Native.Words,
    Compiler.Native.X86.Asm,
    Compiler.Native.X86.Encode,
    Compiler.Native.X86.Render,
    Compiler.Native.X86.Target,
    Flat.Check,
    Flat.ConstType,
    Flat.Exp,
    Flat.Judgement,
    Flat.Marked,
    Flat.Oracle,
    Flat.Problem,
    Flat.Report,
    Flat.Translate,
    Flat.Uniform

main = Main
executable = idris2-native
