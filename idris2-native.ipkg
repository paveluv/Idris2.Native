package idris2-native

version = 0.1.0
authors = "Pavel Uvarov"
license = "BSD-3-Clause"
brief = "Idris 2 with a native code generator"

depends = idris2, contrib, network

sourcedir = "src"

-- Installed as a library too, for the tests that build terms and programs
-- with the code generator's own modules.
modules =
    Native.Area,
    Native.Carrier,
    Native.Codegen.CastWay,
    Native.Codegen.ConstantWord,
    Native.Codegen.Doubles,
    Native.Codegen.ELF,
    Native.Codegen.Evaluate,
    Native.Codegen.IRCommon.ConIds,
    Native.Codegen.IRCommon.Conv,
    Native.Codegen.IRCommon.Op,
    Native.Codegen.IRCommon.Pinned,
    Native.Codegen.IRCommon.Ty,
    Native.Codegen.IntWidth,
    Native.Codegen.Link,
    Native.Codegen.Linkage.Areas,
    Native.Codegen.Linkage.ConvertsIn,
    Native.Codegen.Linkage.Expansion,
    Native.Codegen.Linkage.ForeignFunctions,
    Native.Codegen.Linkage.OSService,
    Native.Codegen.Linkage.Realised,
    Native.Codegen.Linkage.ResumePoint,
    Native.Codegen.Linkage.Routine,
    Native.Codegen.Linkage.RuntimeModule,
    Native.Codegen.Linkage.Sym,
    Native.Codegen.Linkage.SystemLibrary,
    Native.Codegen.LittleEndian,
    Native.Codegen.LocatedIR.Block,
    Native.Codegen.LocatedIR.Cont,
    Native.Codegen.LocatedIR.Dump,
    Native.Codegen.LocatedIR.Function,
    Native.Codegen.LocatedIR.Instr,
    Native.Codegen.LocatedIR.Label,
    Native.Codegen.LocatedIR.Mem,
    Native.Codegen.LocatedIR.Opnd,
    Native.Codegen.LocatedIR.Program,
    Native.Codegen.LocatedIR.Reach,
    Native.Codegen.LocatedIR.Reg,
    Native.Codegen.LocatedIR.Static,
    Native.Codegen.LocatedIR.Terminator,
    Native.Codegen.Lower,
    Native.Codegen.LowerFlat,
    Native.Codegen.Native,
    Native.Codegen.Platform,
    Native.Codegen.ProgramReach,
    Native.Codegen.RegAlloc,
    Native.Codegen.Seed,
    Native.Codegen.StaticRead,
    Native.Codegen.Strings,
    Native.Codegen.Target,
    Native.Codegen.TermIR.Body,
    Native.Codegen.TermIR.Build,
    Native.Codegen.TermIR.Decls,
    Native.Codegen.TermIR.Def,
    Native.Codegen.TermIR.FieldTys,
    Native.Codegen.TermIR.Instr,
    Native.Codegen.TermIR.IsInt,
    Native.Codegen.TermIR.Mem,
    Native.Codegen.TermIR.Opnd,
    Native.Codegen.TermIR.OvOp,
    Native.Codegen.TermIR.Program,
    Native.Codegen.TermIR.Sig,
    Native.Codegen.TermIR.Sizes,
    Native.Codegen.TermIR.StaticDef,
    Native.Codegen.TermIR.StaticSig,
    Native.Codegen.TermIR.Var,
    Native.Codegen.ValueWord,
    Native.Codegen.Words,
    Native.Codegen.X86.Asm,
    Native.Codegen.X86.Assembler,
    Native.Codegen.X86.Datum,
    Native.Codegen.X86.Encode,
    Native.Codegen.X86.InstrFormat,
    Native.Codegen.X86.LabelTable,
    Native.Codegen.X86.OptionalByte,
    Native.Codegen.X86.Render,
    Native.Codegen.X86.Target,
    Native.Data.AtIndex,
    Native.Data.Builder,
    Native.Data.ByteSink,
    Native.Data.Distinct,
    Native.Data.GrowingBuffer,
    Native.Data.RAList,
    Native.Data.WriteBuilder,
    Native.Failure,
    Native.Field,
    Native.Flat.Check,
    Native.Flat.ConstType,
    Native.Flat.Definition,
    Native.Flat.Exp,
    Native.Flat.Judgement,
    Native.Flat.Marked,
    Native.Flat.Oracle,
    Native.Flat.Problem,
    Native.Flat.Report,
    Native.Flat.Translate,
    Native.Flat.Uniform,
    Native.HeapObj.LayoutWord,
    Native.HeapObj.Shape,
    Native.HeapObj.ValEnc,
    Native.Intrinsic,
    Native.Mach,
    Native.OpenFlag,
    Native.Port,
    Native.Primitive,
    Native.Primitive.Div128,
    Native.Primitive.DoubleBits,
    Native.Primitive.Mul128,
    Native.Rep,
    Native.Routine,
    Native.Service,
    Native.Types.BignumEnc,
    Native.Types.Bytes,
    Native.Types.ConId,
    Native.Types.Enc,
    Native.Types.FromWords,
    Native.Types.Header,
    Native.Types.IntegerRoutine,
    Native.Types.Kind,
    Native.Types.PureLoad,
    Native.Types.Repr,
    Native.Types.StringEnc,
    Native.Types.StringRoutine,
    Native.Types.Struct,
    Native.Width

main = Main
executable = idris2-native
