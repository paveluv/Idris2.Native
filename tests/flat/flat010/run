. ../../testutils.sh

idris2 --cg flat-oracle -o names Names.idr
sed -e 's/^%cg native flat swap$/%cg native flat Main.swap/' -e '/^%cg native flat missing$/d' Names.idr > Qualified.idr
idris2 --cg flat-oracle --exec main Qualified.idr
rm -f Qualified.idr
idris2 --check Twice.idr
sed -e '/^%cg native flat f Twice.f$/d' -e 's/f "x"/1/' -e 's/^module Twice/module Operator/' -e 's/Twice[.](+!)/Operator.(+!)/' Twice.idr > Operator.idr
idris2 --cg flat-oracle --directive dump-flat=flat.txt --exec main Operator.idr
cat flat.txt
rm -f flat.txt Operator.idr
