Main.colour ({arg:11} : Main.Colour [Word]) : (Prelude.Types.Maybe Double) [Word, Dbl] =
  case {arg:11} of
    Main.Red{0} => Prelude.Types.Just{1}(1.0)
    _ => Prelude.Types.Nothing{0}
  shape Main.Colour = {Main.Red#0 as tag | Main.Green#1 as tag | Main.Blue#2 as tag}
  shape (Prelude.Types.Maybe Double) = {Prelude.Types.Nothing#0 as object 0 | Prelude.Types.Just#1 as object 1 (Double)}

Main.meters ({arg:9} : Main.Meters [Dbl]) : Main.Shape [Word, Dbl, Word, Word] =
  case {arg:9} of
    Main.MkMeters ({e:10} : Double [Dbl]) => Main.Circle{0}({e:10})
  shape Main.Meters = {Main.MkMeters#0 as field 0 (Double)}
  shape Main.Shape = {Main.Circle#0 as object 0 (Double) | Main.Rect#1 as object 1 (Bits64, Bits64) | Main.Empty#2 as object 2}

Main.mixed ({arg:0} : Main.Mixed [Word, Dbl, Word]) : (Builtin.Pair Bits64 (Builtin.Pair Bits64 Bits64)) [Word, Word, Word] =
  Builtin.MkPair(let {orig:8} : Bits8 [Word] = case {arg:0} of
      Main.MkMixed ({e:4} : Bits8 [Word]) ({e:5} : Double [Dbl]) ({e:6} : Main.Heap []) ({e:7} : Prelude.Basics.Bool [Word]) => {e:4}
  cast-Bits8-Bits64({orig:8}), Builtin.MkPair(2, 3))
  shape Main.Mixed = {Main.MkMixed#0 as object 0 (Bits8, Double, {Main.MkHeap#0 as object 0}, {Prelude.Basics.False#0 as tag | Prelude.Basics.True#1 as tag})}
  shape (Builtin.Pair Bits64 (Builtin.Pair Bits64 Bits64)) = {Builtin.MkPair#0 as object 1 (Bits64, {Builtin.MkPair#0 as object 1 (Bits64, Bits64)})}

