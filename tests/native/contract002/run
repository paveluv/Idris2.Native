. ../../testutils.sh

# The intrinsics, the other half of the runtime contract: what the native
# code generator provides to the runtime's code; and the OS services, what
# the platform's module provides to the rest of the runtime. A copy of the
# runtime that declares two intrinsics otherwise than the contract says,
# `prim__load64` with a third argument and `prim__store8` with a result, and
# one service, `prim__os_write` with a fourth argument, built as a later
# version so that it is the one found, is refused when a program is
# compiled, before anything is lowered, with each difference named.
cp -r ../../../runtime broken
sed -i -e 's/^%extern prim__load64 : (base, offset : Bits64)/%extern prim__load64 : (base, offset, extra : Bits64)/' \
       -e 's/^load64 a = prim__load64 a.word$/load64 a off = prim__load64 a.word off 0/' \
       -e 's/^loadAt = prim__load64$/loadAt b o = prim__load64 b o 0/' \
       -e 's/^%extern prim__store8 : (base, offset, value : Bits64) -> (1 m : Heap) -> Ret Heap ()$/%extern prim__store8 : (base, offset, value : Bits64) -> (1 m : Heap) -> Ret Heap Bits64/' \
       -e 's/^store8 a = prim__store8 a.word$/store8 a off v m = let (m2 # _) = prim__store8 a.word off v m in m2 # ()/' \
       broken/Runtime/Memory.idr
sed -i -e 's/^%extern prim__os_write : (handle, address, bytes : Bits64)/%extern prim__os_write : (handle, address, bytes, flags : Bits64)/' \
       -e 's/^osWrite = prim__os_write$/osWrite h a n = prim__os_write h a n 0/' \
       broken/Runtime/OS.idr
sed -i -e 's/^version = .*/version = 999.0.0/' broken/idris2-native-runtime.ipkg
(cd broken && idris2 --build idris2-native-runtime.ipkg > /dev/null)
mkdir -p packages/idris2-native-runtime-999.0.0
cp -r broken/build/ttc/* packages/idris2-native-runtime-999.0.0/
append_package_path "$PWD/packages"
idris2 --cg native -o main Main.idr
rm -rf broken packages
