. ../../testutils.sh

# The runtime contract, checked where the runtime is built: each function
# the runtime gives for an entry of the contract (its routines, the string
# encoding's, the platform's services) is declared by the entry's port, and
# Idris checks it against the port where it is defined. A copy of the
# runtime with one fault at a time is built, and Idris's error shown, where
# it is and what does not match:
#
# * `start` is defined with a third argument, which its port does not have;
# * `crash` is declared by `allocSlow`'s port: its body uses its first
#   argument as a message's raw address, where that port gives a count;
# * `allocSlow` gives the raw memory it grew rather than the object there:
#   refused, the port giving an object's address, where a check of the
#   registers alone would let it through, both being one word;
# * the platform's `reserve` is declared by `commit`'s port: its body, which
#   gives an address, does not fit that port, which gives a word.
# The copy is made under build/, which the linter and git leave alone, so
# that a lint run at the same time as the tests does not read it.
fault() {
  rm -rf build/broken
  mkdir -p build
  cp -r ../../../runtime build/broken
  rm -rf build/broken/build
  what=$1; file=$2; shift 2
  sed -i "$@" build/broken/Native/Runtime/$file
  echo "$what:"
  (cd build/broken && idris2 --build idris2-native-runtime.ipkg 2>&1) | sed -n '/^Error/,/^$/p' | grep "^Error\|^Mismatch" | head -2
}
fault "start of three words" Start.idr -e 's/^start entry window = do/start entry window _ = do/'
fault "crash by allocSlow's port" System.idr \
  -e 's/^crash : PortTy Memory.Addr (Routine.port Routine.Crash)$/crash : PortTy Memory.Addr (Routine.port Routine.AllocSlow)/'
fault "allocSlow giving its raw memory" Space.idr -e 's/^  Heap.pure (Memory.objectAt a)$/  Heap.pure a/'
fault "reserve by commit's port" OS/LinuxX86_64.idr \
  -e 's/^reserve : PortTy Memory.Addr (Service.port Service.Reserve)$/reserve : PortTy Memory.Addr (Service.port Service.Commit)/'
rm -rf build/broken
