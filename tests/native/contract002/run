. ../../testutils.sh

# The runtime contract, checked where the runtime is built: each record the
# runtime gives (its routines, the string encoding's) is checked by Idris
# against the contract's ports, field by field, and a record must give every
# field; each function declared by a port (the platform's services) is
# checked against it where it is defined. A copy of the runtime with one
# fault at a time is built, and Idris's error shown, where it is and what
# does not match:
#
# * `start` takes a third word: the routines' record refuses it, the port of
#   `start` taking two;
# * the routines' record leaves `crash` out: the record is not whole;
# * `allocSlow` is bound to x86-64 Linux's `reserve`, which has the same
#   registers, a word in and a word out, but gives a raw address where the
#   port gives an object's address: refused, where a check of the registers
#   alone would let it through;
# * the platform's `reserve` is declared by `commit`'s port: its body, which
#   gives an address, does not fit that port, which gives a word.
fault() {
  rm -rf broken
  cp -r ../../../runtime broken
  rm -rf broken/build
  what=$1; file=$2; shift 2
  sed -i "$@" broken/Native/Runtime/$file
  echo "$what:"
  (cd broken && idris2 --build idris2-native-runtime.ipkg 2>&1) | sed -n '/^Error/,/^$/p' | grep "^Error\|^Mismatch" | head -2
}
fault "start of three words" Start.idr \
  -e 's/^start : (entry : Raw) -> (window : Bits64)/start : (entry : Raw) -> (window, extra : Bits64)/' \
  -e 's/^start entry window = do/start entry window _ = do/'
fault "no crash" Routines.idr -e 's/^    , crash = System.crash }/    }/'
fault "allocSlow giving a raw address" Routines.idr \
  -e 's/allocSlow = Space.allocSlow/allocSlow = LinuxX86_64.reserve/' \
  -e 's/^import Native.Runtime.Memory$/import Native.Runtime.Memory\nimport Native.Runtime.OS.LinuxX86_64/'
fault "reserve by commit's port" OS/LinuxX86_64.idr \
  -e 's/^reserve : PortTy Memory.Addr (Service.port Service.Reserve)$/reserve : PortTy Memory.Addr (Service.port Service.Commit)/'
rm -rf broken
