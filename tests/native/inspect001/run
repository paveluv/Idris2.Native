. ../../testutils.sh

# The inspection gate (Inspect.idr): what the backend's hand-written
# instances and encoding tables promise, checked over every constructor.
# Only the gate's deliberately broken type may fail.
idris2 -p idris2-native -p idris2 Inspect.idr -o inspect > /dev/null
./build/exec/inspect

# Every hand-written Eq in the backend is gated: the instances in its source,
# less the gate's list, must be empty.
grep -rhE '^((public )?export )?([^=]*=> *)?Eq \(?[A-Z][A-Za-z0-9]*.* where *$' ../../../src/Compiler/Native \
  | sed -E 's/.*Eq \(?([A-Z][A-Za-z0-9]*).*/\1/' | sort -u > build/eq-instances
./build/exec/inspect --gated | sort -u > build/eq-gated
comm -23 build/eq-instances build/eq-gated | sed 's/^/not gated: /'
