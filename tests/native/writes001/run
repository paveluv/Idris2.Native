. ../../testutils.sh

# What each x86-64 instruction writes, as the register allocator's table
# says (Native.Codegen.X86.Writes), against the machine: every form run on
# it, its operands over the general registers, between dumps of every
# register; each register that changes must be one the table names. Built
# with the code generator's modules (the package `idris2-native`).
idris2 -p idris2-native -p idris2 Gen.idr -o gen > /dev/null
./build/exec/gen
./oracle > dumps
echo "oracle status: $?"
./build/exec/gen check dumps
rm -f oracle dumps
