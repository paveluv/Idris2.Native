. ../../testutils.sh

# The term IR (Compiler.Native.TermIR), built through the builder and
# allocated into the located IR (Compiler.Native.RegAlloc): a program that runs, with
# every construct the rendering supports, and the IR of a program with every
# other construct. It uses the code
# generator's modules, installed as the package `idris2-native`.
idris2 -p idris2-native -p idris2 Gen.idr -o gen > /dev/null
./build/exec/gen
./term
echo "exit status: $?"
rm -f term
