. ../../testutils.sh

# The slow path of an allocation of a fixed size keeps every register, and
# reloads a GC-visible one as the collector forwarded it. A program built
# from the term IR, with the code generator's modules (the package
# `idris2-native`), holds words, a double and an object in registers across
# an allocation whose slow path writes those registers and moves every
# object.
idris2 -p idris2-native -p idris2 Gen.idr -o gen > /dev/null
./build/exec/gen
./keep 2>&1
echo "exit status: $?"
rm -f keep
