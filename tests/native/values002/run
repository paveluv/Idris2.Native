. ../../testutils.sh

# The value check (Native.Codegen.ValueCheck) as the oracle of register
# allocation: programs generated at random in the term IR, each allocated
# as the code generator allocates it, every one accepted. Built with the
# code generator's modules (the package `idris2-native`).
idris2 -p idris2-native -p idris2 Gen.idr -o gen > /dev/null
./build/exec/gen
