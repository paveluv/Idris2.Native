. ../../testutils.sh

# The rendering's check of its code against the rows (Native.Codegen.X86.Rows)
# on located IR written by hand: functions it renders, and functions whose
# code would write a register the row does not name, which it refuses. It
# uses the code generator's modules (the package `idris2-native`).
idris2 -p idris2-native -p idris2 Gen.idr -o gen > /dev/null
./build/exec/gen
