function Main.main CPS [] entry 0
  0:
    TailCall Main.countDown (#7)

function Main.countDown CPS [slot0:Val] entry 0
  0:
    slot1:W64 := #3
    Jump 1
  1:
    Branch slot1:W64 == #0 3 4
  2:
    [9] slot5:W64 := Sub slot1:W64, #1
    (slot1:W64) := (slot5:W64)
    Jump 1
  3:
    Return slot0:Val
  4:
    [6] slot3:Ptr INT64 := AllocObj INT64 (slot1:W64) live [slot0:Val, slot1:W64]
    [7] slot4:Val := Widen slot3:Ptr INT64
    (slot2:Val) := (slot4:Val)
    Jump 2

