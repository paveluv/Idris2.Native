. ../../testutils.sh

# The rules over what modules use, resolved from the TTCs their build
# writes, so the fixtures are built first. `Gallery` and `Report` use
# `Shape` (a name written, an implementation found by search) reached only
# through `Canvas`'s re-export, and `Viewer` through a façade, and a
# package's module through a package's re-export, all reported; `Spare` imports
# a module it does not use, and `Frame` one that gives it only what it
# imports directly; `JoinAll` accumulates lists in each shape, the
# superlinear ones reported, a warning; `Shape` exports a generic helper;
# `Raw` uses a raw extern of the contract outside the module that wraps it.
# Then the score's components that the resolution measures.
idris2 --build fixtures.ipkg > /dev/null
../../../tools/lint/build/exec/idris2-native-lint --resolved --warnings .
../../../tools/lint/build/exec/idris2-native-lint --resolved --health . | grep "directness\|leanness\|accumulation"

# A source changed after its build: its TTC no longer says what it uses, so
# nothing is resolved, and the finding says so.
touch Spare.idr
../../../tools/lint/build/exec/idris2-native-lint --resolved .
rm -rf build
