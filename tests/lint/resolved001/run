. ../../testutils.sh

# The rules over what modules use, resolved from the TTCs their build
# writes, so the fixtures are built first. `Gallery` and `Report` use
# `Shape` (a name written, an implementation found by search) reached only
# through `Canvas`'s re-export, and `Viewer` through a façade, and a
# package's module through a package's re-export, all reported; `Spare` imports
# a module it does not use, and `Frame` one that gives it only what it
# imports directly; `Shape` exports a generic helper;
# `Page` makes a raw address from a word; `Native.Support.Lease` leaves
# the allocator's linear blocks, at base's foreign surface and outside it;
# `Values` converts a value through the core's conversion, not the support
# tier's door.
# Then the score's components that the resolution measures, and the
# accumulation with what costs it: `JoinAll` accumulates lists in each
# shape, the superlinear ones counted against it.
idris2 --build fixtures.ipkg > /dev/null
../../../tools/lint/build/exec/idris2-native-lint --resolved .
../../../tools/lint/build/exec/idris2-native-lint --resolved --health . | grep "directness\|leanness"
../../../tools/lint/build/exec/idris2-native-lint --resolved --health --offenders 3 . | sed -n '/^  efficiency/,$p'

# A source changed after its build: its TTC no longer says what it uses, so
# nothing is resolved, and the finding says so; `Kept`'s suppression of a
# rule that did not run is not reported.
touch Spare.idr
../../../tools/lint/build/exec/idris2-native-lint --resolved .
rm -rf build
