--- Moves.idr
||| Helpers that `scope-helpers` moves into the `where` block of the one
||| function using them. The comments between the cases are about the case,
||| and stay where they are; those directly above a helper are its own, and
||| move with it.
module Moves

import Data.Vect

%default total

-- A user with no `where` block gets one, two columns in from its clause,
-- and the helper goes four in, its documentation with it.

export
quadruple : Nat -> Nat
quadruple n = double (double n)
  where
    ||| Twice a number.
    double : Nat -> Nat
    double n = n + n

-- A user with a `where` block already: the helper goes in before the first
-- of the block's functions that uses it, since a block, like a module,
-- defines a name before its use.

export
sumOfSquares : Nat -> Nat -> Nat
sumOfSquares a b = both a b
  where
    square : Nat -> Nat
    square n = n * n

    both : Nat -> Nat -> Nat
    both x y = square x + square y

-- A chain: `inc` is used only by `incTwice`, and `incTwice` only by
-- `incFour`. `inc` goes first, into `incTwice`'s block, and `incTwice`
-- then takes its block with it into `incFour`'s.

export
incFour : Nat -> Nat
incFour n = incTwice (incTwice n)
  where
    incTwice : Nat -> Nat
    incTwice n = inc (inc n)
      where
        inc : Nat -> Nat
        inc = S

-- A type variable the user's type binds too: in the user's block `a` is
-- the user's `a`, one type, and `pairUp y` would not check, so the
-- helper's own is renamed where it is free, to `a'`, and the helper stays
-- generic.

export
twins : (a, b) -> ((a, a), (b, b))
twins (x, y) = (pairUp x, pairUp y)
  where
    -- the same value, twice
    pairUp : a' -> (a', a')
    pairUp x = (x, x)

-- A helper whose type binds `{n : Nat}`, which its user's binds too: in
-- the user's block Idris would confuse the two, so the helper's binder is
-- renamed, `n'`, with what refers to it, and the user's call that names
-- it, `{n}` for `{n = n}`, names the new one: `{n' = n}`. Its `e`, a
-- variable the user's type binds too, is renamed as `a` is above.

export
longer : {n : Nat} -> Vect n e -> Nat -> Bool
longer v m = lengthOf {n' = n} v > m
  where
    lengthOf : {n' : Nat} -> Vect n' e' -> Nat
    lengthOf _ = n'

-- A helper in a block of implicit parameters, all it is in the block: the
-- block's header goes, and the helper takes the parameters in its own
-- type. Its calls pass no implicit, so they stay as they are.

export
plusFour : Nat -> Nat
plusFour = twice (twice S)
  where
    twice : {0 t : Type} -> (t -> t) -> t -> t
    twice f = f . f
--- Stays.idr
||| Helpers that `scope-helpers` leaves where they are, each with why.
module Stays

%default total

-- Used by two clauses of its user: a `where` block belongs to one clause,
-- so the helper would be written twice.

half : Integer -> Integer
half n = div n 2

export
halfOr : Integer -> Maybe Integer -> Integer
halfOr d Nothing = half d
halfOr _ (Just n) = half n

-- A helper using a name that its user's clause binds as a variable: in the
-- user's block, `limit` would be the variable, not the function.

export
limit : Nat
limit = 10

capped : Nat -> Nat
capped n = min n limit

export
clamp : (limit : Nat) -> Nat -> Nat
clamp limit n = if n > limit then capped limit else capped n

-- A helper in a block of explicit parameters, used outside it: each call
-- passes the parameter, and moved out of the block it would take one more
-- argument.

parameters (base : Nat)
  offset : Nat -> Nat
  offset n = base + n

export
shifted : Nat -> Nat
shifted n = offset 5 n
--- Merges.idr
||| What `merge-clauses` changes: a function several of whose clauses use a
||| helper only it uses becomes one clause with a `case`, so that
||| `scope-helpers` can then move the helper into its `where` block, which a
||| clause of its own would not hold for the others.
module Merges

import Data.Vect

%default total

public export
data Shape = Circle Nat | Square Nat | Dot

-- One argument matched: the case is on it, named after its type, `shape`.
-- The argument every clause names alike, or leaves `_`, `scale`, stays an
-- argument. Each clause keeps its lines, two columns in.

export
size : Nat -> Shape -> Nat
size scale shape = case shape of
  Circle r => scale * twice r
  Square s => scale * twice s
  Dot => 0
  where
    twice : Nat -> Nat
    twice n = n + n

-- Two arguments matched: the case is on a tuple of them, the second name
-- after the type taken by the first, so primed.

export
nand : Bool -> Bool -> Bool
nand bool bool' = case (bool, bool') of
  (True, True) => flipped True
  (x, y) => flipped x || flipped y
  where
    flipped : Bool -> Bool
    flipped b = not b

-- A clause's own `where` block joins the one clause's, after the case.

export
describe : Shape -> String
describe shape = case shape of
  Circle r => "circle of " ++ showNat r
  Square s => "square of " ++ showNat s
  Dot => dot
  where
    dot : String
    dot = "a dot"

    showNat : Nat -> String
    showNat = show

-- A `where` block using what its clause's pattern binds, `s`, could not
-- join: in the one clause's block `s` would be bound by nothing.

square : Nat -> Nat
square n = n * n

export
area : Shape -> Nat
area (Circle r) = 3 * square r
area (Square s) = squared
  where
    squared : Nat
    squared = square s
area Dot = 0

-- Arguments whose types depend on each other: as a case on a tuple, the
-- match of `x :: _` no longer tells the first is `S k`, and the case does
-- not cover. Only the type checker knows: the run's check finds it, and
-- the change is undone.

pick : a -> a
pick x = x

export
headOr : (n : Nat) -> Vect n a -> a -> a
headOr (S k) (x :: _) _ = pick x
headOr Z [] d = pick d
--- Shared.idr
||| Helpers whose type variables have the names of their users' own, so
||| that moved into their users they could mean the users' or stay their
||| own. Which one only the type checker can judge: with a check, a helper
||| is moved as it is first, its constraint gone where its user has it, and
||| kept general, its variable renamed, only if that does not check.
module Shared

%default total

interface Sized a where
  size : a -> Nat

export
total2 : Sized a => a -> a -> Nat
total2 x y = twice x + twice y
  where
    -- Used only at its user's `a`: moved as it is, without `Sized a =>`,
    -- which search finds in its user's.
    twice : a -> Nat
    twice x = size x + size x

export
both : Sized a => Sized b => a -> b -> Nat
both x y = one x + one y
  where
    -- Used at its user's `a` and at its `b`: kept general where it goes, as
    -- `Sized a' => a' -> Nat`.
    one : Sized a' => a' -> Nat
    one x = size x
--- Primed.idr
||| Local functions with primed type variables, as `scope-helpers` moves
||| them without a check: each kept as general as it was. `unprime` gives a
||| variable back the name of its user's where that checks: there the
||| function is used only at its user's types, and its constraint, which
||| then repeats its user's, goes too.
module Primed

%default total

interface Sized a where
  size : a -> Nat

-- Used only at its user's `a`: `twice : a -> Nat` once unprimed.
export
total2 : Sized a => a -> a -> Nat
total2 x y = twice x + twice y
  where
    twice : a -> Nat
    twice x = size x + size x

-- Used at its user's `a` and at its `b`: stays general, as it does not
-- check at `a` alone.
export
both : Sized a => Sized b => a -> b -> Nat
both x y = one x + one y
  where
    one : Sized a' => a' -> Nat
    one x = size x
--- Unused.idr
||| What `remove-unused` takes out: the private functions nothing uses.
module Unused

%default total

-- A private function something uses stays, and so does one exported.

used : Nat
used = 1

export
answer : Nat
answer = used

-- `main` is what a program starts at: nothing in it calls it, and it stays.

main : IO ()
main = printLn answer
--- Imports.idr
||| What `order-imports` changes: the public imports first, then the private
||| ones, each alphabetical.
module Imports

import public Data.Maybe

import Data.List
import Data.String

%default total

export
joined : List String -> String
joined = fastConcat . intersperse ", " . map trim . catMaybes . map Just
