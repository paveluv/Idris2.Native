. ../../testutils.sh

# The architectural health of a small set of modules: each component's value and what it counts, so that a change in
# how the score is computed shows here. Then the same with the offenders:
# under each component short of 100, the two that cost it most, each with
# its cost in the component's units and what the cost is made of (the
# modules named after nothing they define, the names that meet). The
# components that read resolved names, precision and separation among
# them, are concepts001's.
../../../tools/lint/build/exec/idris2-native-lint --health .
../../../tools/lint/build/exec/idris2-native-lint --health --offenders 2 .

# The gate's run: the findings, none here, then the score of the files
# before `--unscored`, failing below the minimum. `Elsewhere`, named after
# nothing it defines, is bound by the rules but not scored: the names count
# three modules of three.
../../../tools/lint/build/exec/idris2-native-lint --minimum 99 Bat.idr Owl.idr Night.idr --unscored Elsewhere.idr || echo "exit $?"
