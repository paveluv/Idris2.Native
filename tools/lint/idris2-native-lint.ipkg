package idris2-native-lint

version = 0.1.0
authors = "Pavel Uvarov"
license = "BSD-3-Clause"
brief = "The linter of idris2-native: rules over Idris's own parse trees"

depends = idris2, contrib

sourcedir = "src"

modules =
    Lint.Concept,
    Lint.Distinction,
    Lint.Finding,
    Lint.Graph,
    Lint.Main,
    Lint.Precision,
    Lint.Qualifier,
    Lint.Refactor.Binders,
    Lint.Refactor.Change,
    Lint.Refactor.Constraints,
    Lint.Refactor.Edit,
    Lint.Refactor.Extent,
    Lint.Refactor.Free,
    Lint.Refactor.InlineAlias,
    Lint.Refactor.JoinModules,
    Lint.Refactor.Listing,
    Lint.Refactor.MergeClauses,
    Lint.Refactor.NamedArguments,
    Lint.Refactor.OrderImports,
    Lint.Refactor.ParameterBlock,
    Lint.Refactor.Project,
    Lint.Refactor.PruneImports,
    Lint.Refactor.QualifyNames,
    Lint.Refactor.Refactoring,
    Lint.Refactor.ReflowLines,
    Lint.Refactor.RemoveUnused,
    Lint.Refactor.Rename,
    Lint.Refactor.Reindent,
    Lint.Refactor.RenameModule,
    Lint.Refactor.ScopeHelpers,
    Lint.Refactor.Span,
    Lint.Refactor.SplitModule,
    Lint.Refactor.Subject,
    Lint.Refactor.Unprime,
    Lint.Refactor.Where,
    Lint.Resolution,
    Lint.ResolvedRules,
    Lint.Rules,
    Lint.Separation,
    Lint.Source

main = Lint.Main
executable = idris2-native-lint
