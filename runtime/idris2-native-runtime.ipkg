package idris2-native-runtime

version = 0.1.0
authors = "Pavel Uvarov"
license = "BSD-3-Clause"
brief = "The runtime of Idris 2's native code generator"

depends = idris2-native

modules =
    Native.Runtime,
    Native.Runtime.Alloc.Allocator,
    Native.Runtime.Alloc.Arena,
    Native.Runtime.Alloc.Block,
    Native.Runtime.Alloc.Blocks,
    Native.Runtime.Alloc.Chunks,
    Native.Runtime.Alloc.Config,
    Native.Runtime.Alloc.Pages,
    Native.Runtime.Alloc.SizeClasses,
    Native.Runtime.Alloc.System,
    Native.Runtime.Bits,
    Native.Runtime.ByteAddr,
    Native.Runtime.Collect,
    Native.Runtime.Memory,
    Native.Runtime.OS,
    Native.Runtime.OS.LinuxX86_64,
    Native.Runtime.OS.Syscall,
    Native.Runtime.Ordo,
    Native.Runtime.PortTy,
    Native.Runtime.Space,
    Native.Runtime.Start,
    Native.Runtime.State,
    Native.Runtime.Cell,
    Native.Runtime.System,
    Native.Support,
    Native.Support.Bignum.Run,
    Native.Support.Bignum.SignMagnitude,
    Native.Support.BufferObj,
    Native.Support.CodePoint,
    Native.Support.Double.Between,
    Native.Support.Double.Limbs,
    Native.Support.Double.Nearest,
    Native.Support.Double.PowerOfTen,
    Native.Support.Double.Shortest,
    Native.Support.Foreign.Data.Buffer,
    Native.Support.Foreign.Prelude.IO,
    Native.Support.Foreign.PrimIO,
    Native.Support.Obj,
    Native.Support.Ptr,
    Native.Support.String.Utf8,
    Native.Support.StructObj,
    Native.Support.Table,
    Native.Support.Table.Row,
    Native.Support.Text,
    Native.System,
    Native.System.Call,
    Native.System.Environment,
    Native.System.Errno,
    Native.System.ErrorMessage,
    Native.System.File,
    Native.System.Foreign.Prelude.IO,
    Native.System.Foreign.System,
    Native.System.Foreign.System.Directory,
    Native.System.Foreign.System.Errno,
    Native.System.Foreign.System.FFI,
    Native.System.Foreign.System.File.Buffer,
    Native.System.Foreign.System.File.Error,
    Native.System.Foreign.System.File.Handle,
    Native.System.Foreign.System.File.Meta,
    Native.System.Foreign.System.File.Permissions,
    Native.System.Foreign.System.File.Process,
    Native.System.Foreign.System.File.ReadWrite,
    Native.System.Foreign.System.File.Virtual,
    Native.System.Foreign.System.Term
