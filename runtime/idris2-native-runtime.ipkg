package idris2-native-runtime

version = 0.1.0
authors = "Pavel Uvarov"
license = "BSD-3-Clause"
brief = "The runtime of Idris 2's native code generator"

depends = idris2-native

modules =
    Runtime,
    Runtime.Collect,
    Runtime.Foreign.System,
    Runtime.Heap,
    Runtime.Memory,
    Runtime.Object,
    Runtime.OS,
    Runtime.OS.LinuxX86_64,
    Runtime.OS.Syscall,
    Runtime.Space,
    Runtime.Start,
    Runtime.State,
    Runtime.String.Utf8,
    Runtime.System
